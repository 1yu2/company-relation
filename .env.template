# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
WEB_SEARCH_PROVIDER=doubao  # 可选: doubao | tavily
DOUBAO_SEARCH_API_KEY=  # 豆包联网搜索 API Key
TAVILY_API_KEY=  # Tavily 搜索 API Key https://app.tavily.com/

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# Production credentials (required by docker-compose.prod.yml)
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Public images use the frontend same-origin proxy by default.
# MINIO_PUBLIC_URL=/minio

# # region neo4j
# Docker 容器内使用 bolt://graph:7687；宿主机客户端和 Neo4j Browser 使用 bolt://localhost:7687。
# 密码至少 8 个字符。Neo4j 数据目录初始化后，仅修改 .env 不会自动修改数据库中的既有密码。
# NEO4J_URI=bolt://graph:7687
# NEO4J_USERNAME=
NEO4J_PASSWORD=
# 企业尽调图谱派生快照目录，默认使用容器内 saves/company_due_diligence/graph
# COMPANY_DD_GRAPH_SNAPSHOT_DIR=
# # endregion neo4j

# # region company_due_diligence
# 广东企业 MySQL 仅允许使用只读账号。下面保留本地 .env 的既有格式，应用会安全解析 quote(...)，不会执行 eval。
MYSQL_URL=f"mysql+aiomysql://readonly_user:{quote('replace-with-password')}@mysql.example.com:3306/company_database"
# COMPANY_DD_MYSQL_POOL_SIZE=2
# COMPANY_DD_MYSQL_MAX_OVERFLOW=0
# COMPANY_DD_MYSQL_POOL_RECYCLE_SECONDS=300
# COMPANY_DD_MYSQL_POOL_TIMEOUT_SECONDS=5
# COMPANY_DD_MYSQL_CONNECT_TIMEOUT_SECONDS=8
# COMPANY_DD_MYSQL_STATEMENT_TIMEOUT_SECONDS=10
# COMPANY_DD_EVIDENCE_SNAPSHOT_DIR=
# COMPANY_DD_EVIDENCE_BUCKET=company-due-diligence
# COMPANY_DD_EMBEDDING_TIMEOUT_SECONDS=600
# COMPANY_DD_REPORT_BUCKET=company-due-diligence
# COMPANY_DD_EVALUATION_DATASET_DIR=data/company_due_diligence/evaluation
# COMPANY_DD_EVALUATION_BUCKET=company-due-diligence
# COMPANY_DD_EVALUATION_CONFIG_VERSION=default
# COMPANY_DD_HUMAN_QUALITY_DATASET=  # 可选；默认选择最新冻结且包含 human_verified 样本的数据集
# COMPANY_DD_PERFORMANCE_STRATEGY_VERSION=default
# # endregion company_due_diligence

# # Servies
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_PASSWORD=
# 企业尽调部署态 E2E 使用专用管理员账号；仅在本地 .env 中填写，不要提交凭据。
# E2E_USERNAME=
# E2E_PASSWORD=

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# # PaddleOCR API
# PADDLEOCR_API_TOKEN=
# PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# 必填，至少 32 个字符；可使用 `openssl rand -hex 32` 生成
SANDBOX_PROVISIONER_TOKEN=
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: memory | docker | kubernetes
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 动态沙箱专用网络，不要与 app-network 使用同一个名称
# APP_DOCKER_NETWORK=yuxi-know_app-network
# SANDBOX_DOCKER_NETWORK_PREFIX=yuxi-know-sandbox
# SANDBOX_DOCKER_THREADS_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=yuxi-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=yuxi-thread
# SKILLS_PVC=yuxi-skills  # 当前代码会读取，但 Pod 挂载实际仍只使用 THREAD_PVC
